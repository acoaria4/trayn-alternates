{
  "name": "trayn-alternates",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4180",
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4180",
    "verify": "npm run verify:picker && npm run verify:nurture",
    "assets:prepare": "node scripts/run-nurture.mjs prepare-media.mjs",
    "assets:social": "node scripts/run-nurture.mjs social-preview.mjs",
    "verify:assets": "node scripts/verify-build.mjs && node scripts/run-nurture.mjs verify-assets.mjs",
    "verify:pages": "node scripts/verify-picker.mjs --pages && node scripts/run-nurture.mjs verify-mobile-pages.mjs",
    "preview:pages": "node scripts/serve-pages-preview.mjs",
    "verify:accessibility": "node scripts/run-nurture.mjs audit-accessibility.mjs",
    "verify:browsers": "node scripts/run-nurture.mjs cross-browser.mjs",
    "measure:performance": "node scripts/run-nurture.mjs performance.mjs",
    "verify:nurture": "node scripts/run-nurture.mjs verify.mjs",
    "verify:picker": "node scripts/verify-picker.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
